# Settings for the MAVLink hub. Copy this file to hub.env (same folder as server.js) and
# uncomment what you want to change. Real environment variables take precedence.

# Port the dashboard is served on, and the UDP port the plane sends MAVLink to.
#WEB_PORT=8080
#UDP_PORT=14550

# Largest bulk map download, in tiles. 0 removes the limit (use with your own tile server).
#MAX_TILES=500

# Where saved maps and settings are stored. Default is the per-user app folder, e.g.
# ~/Library/Application Support/MAVLink Hub on a Mac. Point it at a big disk if you like.
#DATA_DIR=/Volumes/BigDisk/MAVLink Hub

# Your own tile sources, with {z} {x} {y} placeholders.
#TILE_STREET_URL=https://example.com/streets/{z}/{x}/{y}.png
#TILE_SAT_URL=https://example.com/imagery/{z}/{x}/{y}.jpg

# Airspace layers on the Map tab. "off" stops the hub fetching FAA data (saved areas and your own
# GeoJSON files in <DATA_DIR>/airspace/ still work).
#AIRSPACE=on
# Hide airspace whose floor is above this height in feet, so only what matters to low flying is drawn.
#AIRSPACE_MAX_FLOOR_FT=400
